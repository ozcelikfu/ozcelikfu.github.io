---
import Base from '../../layouts/Base.astro';
import { getPosts, kindLabels, formatDate } from '../../data/writing';

const posts = await getPosts();
const seriesOrder = ['Mürekkepten Nöronlara', 'Furkan’ın Zihni', 'Küpür Küpür Bilgiler, Kıpır Kıpır Hayat'];
const seriesBlurb: Record<string, string> = {
  'Mürekkepten Nöronlara': 'From ink to neurons — notes and favourite passages from books read along the way.',
  'Furkan’ın Zihni': 'Furkan’s mind — short essays and passing thoughts.',
  'Küpür Küpür Bilgiler, Kıpır Kıpır Hayat': 'Clippings — small pieces of practical knowledge for everyday life.',
};
const groups = seriesOrder
  .map((s) => ({ series: s, items: posts.filter((p) => p.data.series === s) }))
  .filter((g) => g.items.length);
const other = posts.filter((p) => !p.data.series || !seriesOrder.includes(p.data.series));
if (other.length) groups.push({ series: 'Other', items: other });
---
<Base title="Writing" description="Essays and book notes by Furkan Özçelik, mostly in Turkish.">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Writing</p>
      <h1>The <em>notebook</em></h1>
      <p class="lead">Essays, reading notes and small collections of things worth remembering. Mostly written in Turkish.</p>
    </div>
  </header>

  {groups.map((g) => (
    <section class="section" aria-labelledby={`s-${g.series}`}>
      <div class="wrap series">
        <div class="series__head">
          <h2 id={`s-${g.series}`} lang={g.series === 'Other' ? 'en' : 'tr'}>{g.series}</h2>
          {seriesBlurb[g.series] && <p class="muted">{seriesBlurb[g.series]}</p>}
        </div>
        <ul class="posts" role="list">
          {g.items.map((p) => (
            <li>
              <a class="post" href={`/writing/${p.id}/`}>
                <span class="post__meta mono">
                  <span>{kindLabels[p.data.kind]}</span>
                  {p.data.date && <span>{formatDate(p.data.date)}</span>}
                  {p.data.lang === 'tr' && <span class="chip">in Turkish</span>}
                </span>
                <span class="post__title" lang={p.data.lang}>{p.data.title}</span>
                {p.data.summary && <span class="post__summary" lang={p.data.lang}>{p.data.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  .series { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 5vw, 72px); }
  .series__head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .series__head { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; }
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .posts li { border-bottom: 1px solid var(--line); }
  .post { display: grid; gap: 0.35rem; padding: 1.2rem 0; text-decoration: none; }
  .post:hover .post__title { color: var(--accent); }
  .post__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.9rem; color: var(--muted); font-size: 0.72rem; }
  .post__title { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.25; transition: color 0.2s; }
  .post__summary { color: var(--text-2); font-size: 0.95rem; }
  @media (max-width: 820px) { .series { grid-template-columns: 1fr; gap: 0.5rem; } .series__head { position: static; } }
</style>
