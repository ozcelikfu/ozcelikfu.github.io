---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, kindLabels, formatDate, type Post } from '../../data/writing';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props { post: Post; prev?: Post; next?: Post }
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.summary} type="article">
  <article class="article" lang={d.lang}>
    <header class="page-head">
      <div class="wrap wrap--narrow">
        <p class="kicker" lang="en">
          <a href="/writing/">Writing</a>{d.series && <span lang={d.lang}>{d.series}</span>}
        </p>
        <h1 class="article__title">{d.title}</h1>
        <p class="article__meta mono" lang="en">
          <span>{kindLabels[d.kind]}</span>
          {d.date && <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, d.lang)}</time>}
          {d.lang === 'tr' && <span class="chip">in Turkish</span>}
        </p>
      </div>
    </header>
    <div class="wrap wrap--narrow section">
      <div class="prose">
        <Content />
      </div>
      {d.source === 'notion' && (
        <p class="article__origin mono" lang="en">Originally published on the previous Notion site.</p>
      )}
    </div>
  </article>

  <nav class="wrap wrap--narrow pager" aria-label="More writing" lang="en">
    {prev ? (
      <a class="pager__link" href={`/writing/${prev.id}/`}>
        <span class="mono muted">Previous</span><span lang={prev.data.lang}>{prev.data.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="pager__link pager__link--next" href={`/writing/${next.id}/`}>
        <span class="mono muted">Next</span><span lang={next.data.lang}>{next.data.title}</span>
      </a>
    ) : <span />}
  </nav>
  <div class="wrap wrap--narrow">
    <a class="text-link" href="/writing/" lang="en"><Icon name="arrow-right" size={16} class="flip" /> All writing</a>
  </div>
</Base>

<style>
  .kicker a { color: inherit; text-decoration: none; }
  .kicker a:hover { color: var(--accent); }
  .kicker span::before { content: '/'; margin-right: 0.75em; color: var(--line-2); }
  .article__title { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .article__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; color: var(--muted); margin: 0; }
  .article .prose { font-size: 1.08rem; }
  .article .section { padding-top: clamp(32px, 5vw, 56px); }
  .article__origin { margin-top: 3rem; color: var(--muted); font-size: 0.72rem; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .pager__link { display: grid; gap: 0.2rem; text-decoration: none; padding: 1rem; border: 1px solid var(--line); border-radius: 12px; }
  .pager__link:hover { border-color: var(--accent); }
  .pager__link--next { text-align: right; }
  .pager__link span:last-child { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.3; }
  :global(.flip) { transform: scaleX(-1); }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager__link--next { text-align: left; } }
</style>
