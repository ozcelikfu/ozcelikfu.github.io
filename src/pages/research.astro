---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import Icon from '../components/Icon.astro';
import { byTheme } from '../data/publications';

const themes = [
  {
    id: 'decoding',
    numeral: 'I',
    title: 'Neural decoding & image reconstruction',
    lede: 'Recovering what a person sees from their fMRI activity, using the priors of deep generative models.',
    body: [
      'Visual reconstruction is a hard inverse problem: fMRI is slow, noisy and low-dimensional compared to an image. The approach here maps brain activity not to pixels, but to the latent spaces of pretrained generative models, letting those models supply what the brain signal alone cannot.',
      'With instance-conditioned GANs (IJCNN 2022, oral), ridge regression predicts instance features, noise vectors and dense vectors from fMRI, giving reconstructions that keep both semantic attributes and low-level detail; the same model also serves to explore semantic selectivity in the brain. Brain-Diffuser (Scientific Reports 2023) extends this in two stages: a very deep VAE first recovers the layout of a natural scene, and Versatile Diffusion then refines it, conditioned on CLIP-vision and CLIP-text features predicted from fMRI. Region-of-interest analyses relate the predicted latent features back to brain areas.',
      'Joint work with Matteo Ferrante, Nicola Toschi and colleagues extends decoding to captions as well as images, and aligns subjects so that decoders can transfer between brains with little data.',
    ],
  },
  {
    id: 'vision',
    numeral: 'II',
    title: 'Deep learning & human vision',
    lede: 'Using models of fMRI to explain classic findings about how humans recognise objects.',
    body: [
      'Human object recognition relies on a narrow, one-octave spatial-frequency channel, measured psychophysically with critical-band masking. In collaboration with Prof. Denis Pelli’s lab at NYU, an ensemble encoding model of human fMRI served to ask where in the visual hierarchy this channel arises.',
      'Brain-based recognition accuracy, derived with N-way representational classification, was put through the critical-band masking paradigm. The resulting channel matches the human one-octave bandwidth and is conserved across V1 to V4 and category-selective areas.',
    ],
  },
  {
    id: 'aria',
    numeral: 'III',
    title: 'Autism research at Yale',
    lede: 'Machine learning in the service of research that aims at impact for autistic people and their families.',
    body: [
      'Associate Researcher in ARIA (Aligning Research to Impact Autism) at Yale University since 2025, working with Prof. Murat Günel.',
    ],
  },
  {
    id: 'earlier',
    numeral: 'IV',
    title: 'Generative models for remote sensing & beyond',
    lede: 'Earlier work at the ITU Computer Vision Laboratory.',
    body: [
      'PanColorGAN recasts pansharpening as the guided colorization of panchromatic satellite images, trained in a self-supervised way. Further contributions cover self-supervised GANs (DeshuffleGANs) and on learning collective variables for molecular simulations with neural networks (Anncolvar).',
    ],
  },
] as const;
---
<Base title="Research" description="Research themes of Furkan Özçelik: neural decoding and image reconstruction from fMRI, deep learning and human vision, and autism research at Yale.">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Research</p>
      <h1>How the brain <em>sees</em>, and how to read it</h1>
      <p class="lead">Working where deep learning meets cognitive neuroscience: decoding visual experience from brain activity, and using neural networks as models of human vision.</p>
      <nav class="toc" aria-label="Research themes">
        {themes.map((t) => <a href={`#${t.id}`}><span class="mono">{t.numeral}</span> {t.title}</a>)}
      </nav>
    </div>
  </header>

  {themes.map((t) => {
    const pubs = t.id === 'aria' ? [] : byTheme(t.id).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
    return (
      <section class="section theme" id={t.id} aria-labelledby={`${t.id}-h`}>
        <div class="wrap theme__grid">
          <div class="theme__head">
            <p class="kicker"><span class="numeral">{t.numeral}</span>Theme</p>
            <h2 id={`${t.id}-h`}>{t.title}</h2>
            <p class="theme__lede">{t.lede}</p>
          </div>
          <div class="theme__body">
            {t.body.map((para) => <p>{para}</p>)}
            {pubs.length > 0 && (
              <div class="theme__pubs">
                <p class="mono muted theme__pubs-h">Papers</p>
                {pubs.map((p) => <PubItem p={p} />)}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="wrap">
      <p><a class="text-link" href="/publications/">Full publication list <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>
</Base>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .toc a { padding: 0.45em 0.9em; border-radius: 999px; border: 1px solid var(--line-2); text-decoration: none; font-size: 0.9rem; color: var(--text-2); }
  .toc a:hover { border-color: var(--accent); color: var(--accent); }
  .toc .mono { color: var(--hot); margin-right: 0.3em; }
  .theme__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(24px, 5vw, 72px); }
  .theme__head { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; }
  .theme__lede { color: var(--muted); font-size: 1.05rem; }
  .theme__body > p { color: var(--text-2); }
  .theme__pubs { margin-top: 2rem; border-top: 1px solid var(--line); }
  .theme__pubs-h { text-transform: uppercase; letter-spacing: 0.14em; margin: 1rem 0 0; }
  @media (max-width: 860px) { .theme__grid { grid-template-columns: 1fr; } .theme__head { position: static; } }
</style>
