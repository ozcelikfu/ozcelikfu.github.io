---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { publications, typeLabels, type PubType } from '../data/publications';
import { activeLinks } from '../data/profile';

const research = publications.filter((p) => p.theme !== 'meaning');
const years = [...new Set(research.map((p) => p.year!))].sort((a, b) => b - a);
const talks = publications.filter((p) => p.type === 'talk');
const chapters = publications.filter((p) => p.type === 'chapter');
const filters: { key: 'all' | PubType; label: string; count: number }[] = [
  { key: 'all', label: 'All', count: research.length },
  ...(['journal', 'conference', 'workshop'] as PubType[]).map((k) => ({
    key: k,
    label: typeLabels[k],
    count: research.filter((p) => p.type === k).length,
  })),
];
const scholar = activeLinks.find((l) => l.key === 'scholar');
---
<Base title="Publications" description="Publications of Furkan Özçelik on neural decoding, fMRI image reconstruction, human vision and deep generative models.">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Publications</p>
      <h1>Papers, talks <em>&amp;</em> chapters</h1>
      <p class="lead">
        Peer-reviewed work on neural decoding, human vision and generative models, followed by talks and book chapters on AI,
        philosophy and religion.{scholar && <> An up-to-date list is on <a href={scholar.href}>Google Scholar</a>.</>}
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="papers-h">
    <div class="wrap pubs">
      <div class="pubs__bar">
        <h2 id="papers-h" class="pubs__h">Research papers</h2>
        <div class="pubs__filters" role="group" aria-label="Filter by type" data-filters hidden>
          {filters.map((f, i) => (
            <button type="button" class="chip-button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label} <span class="pubs__count">{f.count}</span>
            </button>
          ))}
        </div>
      </div>
      {years.map((y) => (
        <div class="pubs__year" data-year>
          <h3 class="pubs__year-h mono">{y}</h3>
          <div>
            {research.filter((p) => p.year === y).map((p) => <PubItem p={p} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="talks-h">
    <div class="wrap pubs">
      <h2 id="talks-h" class="pubs__h">Talks</h2>
      <div>{talks.map((p) => <PubItem p={p} />)}</div>
      <h2 class="pubs__h pubs__h--gap">Book chapters</h2>
      <div>{chapters.map((p) => <PubItem p={p} />)}</div>
    </div>
  </section>
</Base>

<style>
  .pubs__bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .pubs__h { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0; }
  .pubs__h--gap { margin-top: 3rem; }
  .pubs__filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pubs__count { opacity: 0.6; margin-left: 0.2em; }
  .pubs__year { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 1.5rem; border-top: 1px solid var(--line); }
  .pubs__year-h { font-size: 1rem; color: var(--hot); margin: 1.6rem 0 0; }
  .pubs__year[hidden] { display: none; }
  .pubs :global(.pub[hidden]) { display: none; }
  .pubs__year :global(.pub:last-child) { border-bottom: 0; }
  @media (max-width: 640px) { .pubs__year { grid-template-columns: 1fr; gap: 0; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const years = [...document.querySelectorAll<HTMLElement>('[data-year]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter!;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        years.forEach((y) => {
          const items = [...y.querySelectorAll<HTMLElement>('.pub')];
          let shown = 0;
          items.forEach((it) => {
            const ok = f === 'all' || it.dataset.type === f;
            it.hidden = !ok;
            if (ok) shown++;
          });
          y.hidden = shown === 0;
        });
      }),
    );
  }
</script>
