---
import Base from '../layouts/Base.astro';
import Act from '../components/Act.astro';
import Icon from '../components/Icon.astro';
import PaperList from '../components/PaperList.astro';
import BrainToImage from '../components/viz/BrainToImage.astro';
import TwoStage from '../components/viz/TwoStage.astro';
import SpatialChannel from '../components/viz/SpatialChannel.astro';
import PromptMatrix from '../components/viz/PromptMatrix.astro';
import { profile } from '../data/profile';
import { byTheme, publications } from '../data/publications';
import { getPosts, kindLabels, formatDate } from '../data/writing';

const decoding = byTheme('decoding').sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const vision = byTheme('vision');
const meaning = byTheme('meaning');
const earlier = byTheme('earlier');
const latest = (await getPosts()).slice(0, 3);
const peerReviewed = publications.filter((p) => ['journal', 'conference', 'workshop'].includes(p.type)).length;
---
<Base type="profile">
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__content">
        <p class="kicker kicker--plain">{profile.tagline}</p>
        <h1 id="hero-title" class="hero__title">
          <span>Furkan</span> <em>Özçelik</em>
        </h1>
        <p class="hero__role">{profile.title} · {profile.affiliation}</p>
        <p class="lead">{profile.lead}</p>
        <div class="hero__actions">
          <a class="button" href="#decoding">Begin with the brain <Icon name="arrow-down" /></a>
          <a class="button button--ghost" href="/publications/">Publications <Icon name="arrow-right" /></a>
        </div>
        <dl class="hero__facts">
          <div><dt class="mono">Now</dt><dd>Yale · ARIA</dd></div>
          <div><dt class="mono">PhD</dt><dd>CerCo · CNRS Toulouse</dd></div>
          <div><dt class="mono">Papers</dt><dd>{peerReviewed} peer-reviewed</dd></div>
        </dl>
      </div>
      <div class="hero__viz">
        <BrainToImage />
      </div>
    </div>
  </section>

  <!-- I · Decoding vision -->
  <Act id="decoding" numeral="I" kicker="Decoding vision" eq="x̂ = D( f<sub>θ</sub>(BOLD) )" plate="voxels">
    <h2 id="decoding-title">Reading pictures <em>back</em> out of the brain</h2>
    <p>
      Looking at a photograph leaves a trace of it in the pattern of activity across the visual cortex. The PhD work
      asked how much of the picture can be recovered from that trace. The answer turned out to be: a surprising
      amount — provided the decoder borrows the right priors from modern generative models.
    </p>
    <p>
      First came instance-conditioned GANs, reconstructing perceived images while keeping their semantics. Then came
      <strong>Brain-Diffuser</strong>, a two-stage framework in which a VDVAE recovers the layout of a scene and a latent
      diffusion model, guided by CLIP features predicted from fMRI, fills in meaning and detail.
    </p>
    <PaperList items={decoding} />
    <p><a class="text-link" href="/research/#decoding">More on neural decoding <Icon name="arrow-right" size={16} /></a></p>
    <TwoStage slot="figure" />
  </Act>

  <!-- II · Yale / ARIA -->
  <Act id="aria" numeral="II" kicker="Now at Yale" eq="data → models → impact" plate="network" flip>
    <h2 id="aria-title">Research that aims at <em>impact</em> in autism</h2>
    <p>
      Associate Researcher at Yale University in <strong>ARIA — Aligning Research to Impact Autism</strong>, working with
      Prof. Murat Günel. The program brings together research on the biology of autism with the goal of making that
      research matter for autistic people and families.
    </p>
    <p>
      The role: bringing machine learning and careful modelling to large, heterogeneous data — the same instinct behind
      the decoding work: find the representation in which a hard signal becomes readable.
    </p>
    <p><a class="text-link" href="/experience/">Experience &amp; collaborations <Icon name="arrow-right" size={16} /></a></p>
  </Act>

  <!-- III · Human vision -->
  <Act id="vision" numeral="III" kicker="How humans — and networks — see" eq="channel ≈ 1 octave · V1 → V4 → IT" plate="waves">
    <h2 id="vision-title">One narrow <em>channel</em> for recognising objects</h2>
    <p>
      Psychophysics has long shown that humans recognise letters and objects through a single spatial-frequency channel
      about one octave wide, revealed by critical-band masking: adding noise one frequency band at a time shows which band hurts.
    </p>
    <p>
      Together with Prof. Denis Pelli’s lab at NYU, the question was where this channel comes from. An ensemble encoding
      model of human fMRI yields brain-based recognition accuracy for noisy images, to which the same masking paradigm
      applies. The channel that emerges has the human, one-octave bandwidth — conserved from V1 to V4 and into
      category-selective areas.
    </p>
    <PaperList items={vision} />
    <SpatialChannel slot="figure" />
  </Act>

  <!-- IV · Machines and meaning -->
  <Act id="meaning" numeral="IV" kicker="Machines and meaning" eq="P( answer | argument, identity )" plate="graph" flip>
    <h2 id="meaning-title">Language models and the arguments for <em>God</em></h2>
    <p>
      Beyond the lab: thinking and writing about what AI means for philosophy and religion. Recent talks probed how large
      language models evaluate classical arguments for God’s existence — and how the judgements shift when a model is
      asked to speak as someone else. Also: two book chapters in Turkish on AI, deep learning and large language models,
      and co-founding the Science Philosophy Religion Foundation in Turkey.
    </p>
    <PaperList items={meaning} />
    <p><a class="text-link" href="/ideas/">AI, philosophy &amp; religion <Icon name="arrow-right" size={16} /></a></p>
    <PromptMatrix slot="figure" />
  </Act>

  <!-- Earlier work -->
  <section class="section earlier" aria-labelledby="earlier-title">
    <div class="wrap">
      <div class="section-title">
        <h2 id="earlier-title">Earlier work</h2>
        <p class="mono muted">Istanbul Technical University · 2018 — 2020</p>
      </div>
      <p class="earlier__intro">
        Before neuroscience: generative models for remote sensing and self-supervised GANs at the ITU Computer Vision
        Lab — including PanColorGAN, which recasts pansharpening as guided colorization.
      </p>
      <div class="earlier__grid">
        {earlier.map((p) => (
          <a class="earlier__card card" href={p.links?.doi ? `https://doi.org/${p.links.doi}` : '#'} target="_blank" rel="noopener">
            <span class="mono muted">{p.venueShort} · {p.year}</span>
            <span class="earlier__title">{p.title}</span>
            {p.note && <span class="chip chip--accent">{p.note}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="section" aria-labelledby="writing-title">
    <div class="wrap">
      <div class="section-title">
        <h2 id="writing-title">From the notebook</h2>
        <a class="text-link" href="/writing/">All writing <Icon name="arrow-right" size={16} /></a>
      </div>
      <p class="muted">Essays and reading notes, mostly in Turkish.</p>
      <div class="notes">
        {latest.map((post) => (
          <a class="note card" href={`/writing/${post.id}/`} lang={post.data.lang}>
            <span class="mono muted">{kindLabels[post.data.kind]}{post.data.date && ` · ${formatDate(post.data.date, post.data.lang)}`}</span>
            <span class="note__title">{post.data.title}</span>
            {post.data.summary && <span class="note__summary">{post.data.summary}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding-block: clamp(40px, 7vw, 96px) clamp(56px, 9vw, 120px); overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: -20% -10% auto auto; width: 70vw; height: 70vw; z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 10%, transparent), transparent);
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero__title { margin: 0 0 0.6rem; }
  .hero__title span, .hero__title em { display: block; }
  .hero__role { font-family: var(--font-mono); font-size: 0.9rem; color: var(--accent); margin-bottom: 1.4rem; letter-spacing: 0.02em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2rem 0 2.4rem; }
  .hero__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0.5rem 2.2rem; margin: 0; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .hero__facts dt { color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.68rem; }
  .hero__facts dd { margin: 0.15rem 0 0; font-size: 0.95rem; }
  .hero__viz { max-width: 520px; width: 100%; justify-self: end; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__viz { justify-self: start; max-width: 460px; }
  }
  @media (max-width: 480px) {
    .hero__facts { grid-template-columns: 1fr 1fr; }
  }

  .earlier__intro { color: var(--text-2); max-width: 65ch; }
  .earlier__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .earlier__card { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; text-decoration: none; transition: border-color 0.2s, transform 0.2s var(--ease); }
  .earlier__card:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); transform: translateY(-2px); color: inherit; }
  .earlier__title { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.3; }
  .earlier__card .mono { font-size: 0.72rem; }
  @media (max-width: 820px) { .earlier__grid { grid-template-columns: 1fr; } }

  .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .note { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; transition: border-color 0.2s, transform 0.2s var(--ease); }
  .note:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); transform: translateY(-2px); color: inherit; }
  .note .mono { font-size: 0.72rem; }
  .note__title { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; }
  .note__summary { color: var(--muted); font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 820px) { .notes { grid-template-columns: 1fr; } }
</style>
