---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { positions, teaching, education } from '../data/experience';
---
<Base title="Experience" description="Research positions, teaching and education of Furkan Özçelik: Yale University, NYU, CNRS Toulouse, Neuromatch Academy and Istanbul Technical University.">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Experience</p>
      <h1>From Istanbul to Toulouse, <em>NYU</em> and Yale</h1>
      <p class="lead">Research positions, teaching, and the three theses that trace a single question — how to read images out of the brain.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="pos-h">
    <div class="wrap two-col">
      <h2 id="pos-h">Research</h2>
      <ol class="timeline" role="list">
        {positions.map((p, i) => (
          <li class:list={['timeline__item', { 'is-now': i === 0 }]}>
            <p class="timeline__period mono">{p.period}</p>
            <h3 class="timeline__role">{p.role}</h3>
            <p class="timeline__org">{p.org}{p.group && <span class="muted"> — {p.group}</span>}</p>
            {p.detail && <p class="timeline__detail">{p.detail}</p>}
            {p.with && <p class="timeline__with mono">with {p.with}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="teach-h">
    <div class="wrap two-col">
      <h2 id="teach-h">Teaching</h2>
      <div>
        <p class="muted">Summer schools and courses with teaching roles in deep learning, NeuroAI and computational neuroscience.</p>
        <ul class="teach" role="list">
          {teaching.map((t) => (
            <li>
              <span class="mono teach__period">{t.period}</span>
              <span><strong>{t.group}</strong> <span class="muted">· {t.org} · {t.role}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="edu-h">
    <div class="wrap two-col">
      <h2 id="edu-h">Education</h2>
      <div class="edu">
        {education.map((d) => (
          <article class="edu__item card">
            <p class="mono edu__period">{d.period}</p>
            <h3 class="edu__degree">{d.degree}</h3>
            <p class="edu__org">{d.org}{d.note && <span class="muted"> · {d.note}</span>}</p>
            <div class="edu__thesis">
              <p class="mono muted edu__label">Thesis</p>
              <p class="edu__title">
                {d.thesis.href ? <a href={d.thesis.href} target="_blank" rel="noopener">{d.thesis.title}</a> : d.thesis.title}
              </p>
              <p class="edu__summary">{d.thesis.summary}</p>
              <p class="mono muted edu__sup">Supervisor: {d.thesis.supervisor}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p><a class="text-link" href="/publications/">Publications <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>
</Base>

<style>
  .two-col { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(24px, 5vw, 72px); }
  .two-col > h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  @media (max-width: 760px) { .two-col { grid-template-columns: 1fr; gap: 1rem; } }

  .timeline { list-style: none; margin: 0; padding: 0 0 0 1.5rem; border-left: 1px solid var(--line-2); }
  .timeline__item { position: relative; padding-bottom: 2.2rem; }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__item::before {
    content: ''; position: absolute; left: calc(-1.5rem - 5px); top: 0.45rem;
    width: 9px; height: 9px; border-radius: 2px; background: var(--surface); border: 1px solid var(--accent);
  }
  .timeline__item.is-now::before { background: var(--hot); border-color: var(--hot); box-shadow: 0 0 0 5px var(--hot-soft); }
  .timeline__period { color: var(--hot); margin: 0 0 0.2rem; }
  .timeline__role { font-size: 1.45rem; margin: 0 0 0.15rem; }
  .timeline__org { margin: 0 0 0.3rem; }
  .timeline__detail { color: var(--text-2); margin: 0 0 0.3rem; }
  .timeline__with { color: var(--muted); margin: 0; }

  .teach { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .teach li { display: grid; grid-template-columns: 130px 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
  .teach strong { font-weight: 600; }
  .teach__period { color: var(--muted); padding-top: 0.15em; }
  @media (max-width: 520px) { .teach li { grid-template-columns: 1fr; gap: 0.1rem; } }

  .edu { display: grid; gap: 1rem; }
  .edu__period { color: var(--hot); margin: 0 0 0.2rem; }
  .edu__degree { font-size: 1.45rem; margin: 0 0 0.15rem; }
  .edu__org { margin: 0; color: var(--text-2); }
  .edu__thesis { margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--line-2); }
  .edu__label { text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 0.3rem; font-size: 0.68rem; }
  .edu__title { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.35; margin: 0 0 0.5rem; }
  .edu__title a { text-decoration-color: var(--line-2); }
  .edu__summary { color: var(--text-2); font-size: 0.95rem; margin: 0 0 0.5rem; }
  .edu__sup { margin: 0; }
</style>
