---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { useTranslations, translatedPaths, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const nav = [
  { href: '/research/', label: t('nav.research') },
  { href: '/publications/', label: t('nav.publications') },
  { href: '/experience/', label: t('nav.experience') },
  { href: '/ideas/', label: t('nav.ideas') },
  { href: '/writing/', label: t('nav.writing') },
  { href: '/about/', label: t('nav.about') },
];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const basePath = path.replace(/^\/tr(?=\/)/, '');
const hasTr = translatedPaths.includes(basePath);
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${profile.name} — home`}>
      <span class="brand__mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span class="brand__name">{profile.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul role="list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      {hasTr && (
        <a class="lang-switch mono" href={lang === 'en' ? `/tr${basePath}` : basePath} hreflang={lang === 'en' ? 'tr' : 'en'}>
          {lang === 'en' ? 'TR' : 'EN'}
        </a>
      )}
      <button class="icon-button" type="button" id="theme-toggle"
        data-label-light={t('theme.toLight')} data-label-dark={t('theme.toDark')} aria-label={t('theme.toLight')}>
        <span class="theme-icon theme-icon--sun"><Icon name="sun" /></span>
        <span class="theme-icon theme-icon--moon"><Icon name="moon" /></span>
      </button>
      <button class="icon-button nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t('nav.menu')}>
        <span class="nav-toggle__open"><Icon name="menu" /></span>
        <span class="nav-toggle__close"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    height: var(--header-h);
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner { height: 100%; display: flex; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--text); flex: none; }
  .brand:hover { color: var(--text); }
  .brand__name { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -0.01em; }
  .brand__mark { display: grid; grid-template-columns: repeat(2, 7px); gap: 2px; }
  .brand__mark i { width: 7px; height: 7px; border-radius: 2px; background: var(--accent); opacity: 0.4; transition: opacity 0.4s, background-color 0.4s; }
  .brand__mark i:nth-child(1) { opacity: 1; background: var(--hot); }
  .brand__mark i:nth-child(4) { opacity: 0.75; }
  .brand:hover .brand__mark i { opacity: 1; }

  .site-nav { margin-left: auto; }
  .site-nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .site-nav a {
    display: block; padding: 0.4rem 0.7rem; border-radius: 8px;
    font-size: 0.92rem; color: var(--text-2); text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }
  .site-nav a:hover { color: var(--text); background: var(--accent-soft); }
  .site-nav a[aria-current='page'] { color: var(--accent); }

  .site-header__tools { display: flex; align-items: center; gap: 0.25rem; }
  .icon-button {
    display: inline-grid; place-items: center; width: 38px; height: 38px;
    border-radius: 10px; border: 1px solid transparent; background: transparent; color: var(--text-2); cursor: pointer;
  }
  .icon-button:hover { color: var(--accent); border-color: var(--line-2); }
  .lang-switch { padding: 0.35rem 0.55rem; border-radius: 8px; text-decoration: none; color: var(--text-2); border: 1px solid var(--line-2); }

  .theme-icon--sun { display: none; }
  :global(:root[data-theme='light']) .theme-icon--sun { display: none; }
  :global(:root[data-theme='light']) .theme-icon--moon { display: block; }
  :global(:root[data-theme='dark']) .theme-icon--sun { display: block; }
  :global(:root[data-theme='dark']) .theme-icon--moon { display: none; }

  .nav-toggle { display: none; }
  .nav-toggle__close { display: none; }

  @media (max-width: 900px) {
    .nav-toggle { display: inline-grid; }
    .site-header__tools { margin-left: auto; }
    .site-nav {
      position: fixed; inset: var(--header-h) 0 auto 0; margin: 0;
      background: var(--bg); border-bottom: 1px solid var(--line);
      padding: 0.75rem var(--gutter) 1.25rem;
      display: none;
    }
    .site-nav ul { flex-direction: column; gap: 0; }
    .site-nav a { padding: 0.85rem 0.25rem; font-size: 1.1rem; border-bottom: 1px solid var(--line); border-radius: 0; }
    :global(.nav-open) .site-nav { display: block; }
    :global(.nav-open) .nav-toggle__open { display: none; }
    :global(.nav-open) .nav-toggle__close { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  const syncThemeLabel = () => {
    if (!themeBtn) return;
    const dark = root.getAttribute('data-theme') !== 'light';
    themeBtn.setAttribute('aria-label', dark ? themeBtn.dataset.labelLight! : themeBtn.dataset.labelDark!);
  };
  syncThemeLabel();
  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    syncThemeLabel();
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });

  const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const setNav = (open: boolean) => {
    document.body.classList.toggle('nav-open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
  };
  navToggle?.addEventListener('click', () => setNav(!document.body.classList.contains('nav-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNav(false); });
  document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => setNav(false)));
</script>
