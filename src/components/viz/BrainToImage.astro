---
import Icon from '../Icon.astro';
---
<figure class="hero-viz" data-brain-viz>
  <div class="hero-viz__frame">
    <canvas class="hero-viz__canvas" role="img"
      aria-label="Animated illustration: a slice of fMRI voxels with hot spots of activity turns into noise and is gradually denoised into a picture of a lake at sunset."></canvas>
    <span class="hero-viz__corner hero-viz__corner--tl" aria-hidden="true"></span>
    <span class="hero-viz__corner hero-viz__corner--br" aria-hidden="true"></span>
    <p class="hero-viz__readout mono" aria-hidden="true"><span data-readout>t = 1000</span></p>
  </div>
  <figcaption class="hero-viz__steps">
    <ol role="list">
      <li data-step="0"><span class="mono">01</span> fMRI activity</li>
      <li data-step="1"><span class="mono">02</span> predicted latents</li>
      <li data-step="2"><span class="mono">03</span> reconstruction</li>
    </ol>
    <button class="hero-viz__pause" type="button" data-motion-toggle aria-pressed="false" aria-label="Pause animation">
      <span class="i-pause"><Icon name="pause" size={16} /></span>
      <span class="i-play"><Icon name="play" size={16} /></span>
    </button>
  </figcaption>
  <p class="hero-viz__note mono">Illustration — not real data. Painted scene, simulated activity.</p>
</figure>

<style>
  .hero-viz { margin: 0; width: 100%; }
  .hero-viz__frame {
    position: relative; aspect-ratio: 1; width: 100%;
    border-radius: 18px;
    background:
      radial-gradient(120% 90% at 30% 20%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      radial-gradient(80% 80% at 80% 90%, color-mix(in srgb, var(--hot) 10%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .hero-viz__canvas { position: absolute; inset: 6%; width: 88%; height: 88%; }
  .hero-viz__corner { position: absolute; width: 18px; height: 18px; border-color: var(--line-2); border-style: solid; }
  .hero-viz__corner--tl { top: 12px; left: 12px; border-width: 1px 0 0 1px; }
  .hero-viz__corner--br { bottom: 12px; right: 12px; border-width: 0 1px 1px 0; }
  .hero-viz__readout { position: absolute; top: 10px; right: 16px; margin: 0; color: var(--muted); font-size: 0.7rem; }

  .hero-viz__steps { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.9rem; }
  .hero-viz__steps ol { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; list-style: none; margin: 0; padding: 0; font-size: 0.85rem; color: var(--muted); }
  .hero-viz__steps li { transition: color 0.4s; }
  .hero-viz__steps li .mono { color: var(--line-2); margin-right: 0.25em; transition: color 0.4s; }
  .hero-viz__steps li.is-active { color: var(--text); }
  .hero-viz__steps li.is-active .mono { color: var(--hot); }
  .hero-viz__pause {
    flex: none; display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid var(--line-2); background: transparent; color: var(--text-2); cursor: pointer;
  }
  .hero-viz__pause:hover { color: var(--accent); border-color: var(--accent); }
  .hero-viz__pause .i-play { display: none; }
  .hero-viz__pause[aria-pressed='true'] .i-play { display: block; }
  .hero-viz__pause[aria-pressed='true'] .i-pause { display: none; }
  .hero-viz__note { margin: 0.5rem 0 0; font-size: 0.68rem; color: var(--muted); opacity: 0.8; }
</style>

<script>
  import { paintScene, sampleGrid, prefersReducedMotion, rng, gaussian } from '../../scripts/scene';

  const N = 30;           // voxel grid
  const PERIOD = 13000;   // ms per cycle

  const smooth = (a: number, b: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };
  // fMRI-style "hot" colormap: dark red → orange → yellow → white
  const hot = (v: number): [number, number, number] => {
    v = Math.min(1, Math.max(0, v));
    return [255 * Math.min(1, 0.45 + v * 1.1), 255 * Math.min(1, Math.max(0, v * 1.5 - 0.25)), 255 * Math.max(0, v * 2 - 1.3)];
  };

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;

    const scene = paintScene('lake', 512);
    const grid = sampleGrid(scene, N);
    const r = rng(42);

    // per-voxel static data
    const cells = Array.from({ length: N * N }, (_, i) => {
      const gx = i % N, gy = Math.floor(i / N);
      const x = (gx + 0.5) / N, y = (gy + 0.5) / N;
      // axial brain slice: ellipse, minus inter-hemispheric fissure and ventricles
      const inEllipse = ((x - 0.5) / 0.4) ** 2 + ((y - 0.52) / 0.47) ** 2 < 1;
      const fissure = Math.abs(x - 0.5) < 0.02 && (y < 0.34 || y > 0.82);
      const ventricle = ((Math.abs(x - 0.5) - 0.07) / 0.035) ** 2 + ((y - 0.5) / 0.12) ** 2 < 1;
      const brain = inEllipse && !fissure && !ventricle;
      const dist = Math.hypot(x - 0.5, y - 0.52);
      return {
        x, y, brain, dist,
        delay: r() * 0.35,
        noise: [gaussian(r), gaussian(r), gaussian(r)],
        target: [grid[i * 4], grid[i * 4 + 1], grid[i * 4 + 2]],
      };
    });
    // moving activation clusters (visual cortex at the back gets the strongest)
    const blobs = [
      { x: 0.42, y: 0.84, s: 0.09, a: 1.0, f: 0.9 },
      { x: 0.58, y: 0.85, s: 0.08, a: 0.95, f: 1.1 },
      { x: 0.33, y: 0.62, s: 0.07, a: 0.7, f: 1.7 },
      { x: 0.68, y: 0.58, s: 0.06, a: 0.6, f: 1.3 },
      { x: 0.47, y: 0.28, s: 0.06, a: 0.5, f: 2.1 },
    ];

    let W = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      W = canvas.clientWidth;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(W * dpr);
    };
    resize();
    new ResizeObserver(() => { resize(); draw(lastP, lastT); }).observe(canvas);

    let anatomy = 'rgba(180,190,220,';
    const readTheme = () => {
      anatomy = document.documentElement.getAttribute('data-theme') === 'light' ? 'rgba(40,50,80,' : 'rgba(180,195,230,';
    };
    readTheme();
    window.addEventListener('themechange', () => { readTheme(); draw(lastP, lastT); });

    let lastP = 0.62, lastT = 0;
    function draw(p: number, tSec: number) {
      lastP = p; lastT = tSec;
      const S = W * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, S, S);
      const cs = S / N;

      // phase weights
      const toLatent = smooth(0.26, 0.4, p);        // brain → noise field
      const denoise = smooth(0.4, 0.78, p);         // noise → image
      const toFull = smooth(0.74, 0.84, p);         // voxels → smooth image
      const back = smooth(0.93, 1.0, p);            // fade back to brain
      const gap = cs * (0.14 * (1 - toFull));

      let step = 0;
      if (p > 0.3) step = 1;
      if (p > 0.6) step = 2;
      if (p > 0.95) step = 0;
      steps.forEach((s, i) => s.classList.toggle('is-active', i === step));
      const tStep = Math.round(1000 * (1 - denoise));
      readout.textContent = p < 0.3 || p > 0.95 ? 'BOLD · z-score' : `t = ${String(tStep).padStart(4, ' ')}`;

      if (toFull < 1) {
        for (const c of cells) {
          // fMRI activity value
          let v = 0;
          for (const b of blobs) {
            const pulse = 0.65 + 0.35 * Math.sin(tSec * b.f + b.x * 10);
            v += b.a * pulse * Math.exp(-(((c.x - b.x) ** 2 + (c.y - b.y) ** 2) / (2 * b.s * b.s)));
          }
          v += 0.12 * Math.sin(tSec * 2.3 + c.x * 31 + c.y * 17);
          // reveal of non-brain cells during brain → latent transition (radial)
          const reveal = smooth(c.dist * 0.9, c.dist * 0.9 + 0.25, toLatent * 1.25);
          const visBrain = c.brain ? 1 : 0;
          let alpha = visBrain + (1 - visBrain) * reveal;
          alpha *= 1 - back * (c.brain ? 0 : 1);

          // brain colors
          let br: number, bg: number, bb: number, ba = 1;
          const active = v > 0.42;
          if (active) { [br, bg, bb] = hot((v - 0.42) / 0.55); }
          else { br = bg = bb = -1; ba = 0.16 + v * 0.35; }

          // noise color & image color
          const local = smooth(c.delay, c.delay + 0.65, denoise);
          const nr = 128 + c.noise[0] * 70, ng = 128 + c.noise[1] * 70, nb = 128 + c.noise[2] * 70;
          const ir = c.target[0], ig = c.target[1], ib = c.target[2];
          const lr = nr + (ir - nr) * local, lg = ng + (ig - ng) * local, lb = nb + (ib - nb) * local;

          const m = Math.max(0, toLatent - back);
          let fill: string;
          if (!active && m < 0.02) {
            fill = `${anatomy}${(ba * alpha).toFixed(3)})`;
          } else {
            const sr = br < 0 ? lr : br, sg = bg < 0 ? lg : bg, sb = bb < 0 ? lb : bb;
            const fr = br < 0 ? lr : sr + (lr - sr) * m;
            const fg = bg < 0 ? lg : sg + (lg - sg) * m;
            const fb = bb < 0 ? lb : sb + (lb - sb) * m;
            const a = br < 0 ? Math.max(ba * (1 - m), m) * alpha : alpha;
            fill = `rgba(${fr | 0},${fg | 0},${fb | 0},${a.toFixed(3)})`;
          }
          ctx.fillStyle = fill;
          const gx = (c.x - 0.5 / N) * S, gy = (c.y - 0.5 / N) * S;
          ctx.fillRect(gx + gap / 2, gy + gap / 2, cs - gap + 0.5, cs - gap + 0.5);
        }
      }
      if (toFull > 0) {
        ctx.globalAlpha = toFull * (1 - back);
        ctx.imageSmoothingEnabled = true;
        ctx.drawImage(scene, 0, 0, S, S);
        ctx.globalAlpha = 1;
      }
    }

    // ── animation loop ──
    let raf = 0, start = performance.now() - 0.05 * PERIOD, pausedAt: number | null = null;
    let visible = true;
    const userPaused = () => document.documentElement.classList.contains('motion-paused');
    const frame = (now: number) => {
      const p = ((now - start) % PERIOD) / PERIOD;
      draw(p, now / 1000);
      raf = requestAnimationFrame(frame);
    };
    const play = () => {
      if (raf || !visible) return;
      if (pausedAt !== null) { start += performance.now() - pausedAt; pausedAt = null; }
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      if (!raf) return;
      cancelAnimationFrame(raf); raf = 0; pausedAt = performance.now();
    };
    const syncButton = () => {
      const paused = userPaused();
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
    };

    let stored: string | null = null;
    try { stored = localStorage.getItem('motion'); } catch {}
    if (prefersReducedMotion() && stored !== 'playing') {
      document.documentElement.classList.add('motion-paused');
    }
    syncButton();
    if (userPaused()) {
      start = performance.now() - 0.62 * PERIOD;
      pausedAt = performance.now();
      draw(0.62, 0);
    } else play();

    toggle.addEventListener('click', () => {
      const pause = !userPaused();
      document.documentElement.classList.toggle('motion-paused', pause);
      try { localStorage.setItem('motion', pause ? 'paused' : 'playing'); } catch {}
      syncButton();
      pause ? stop() : play();
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!visible) stop();
      else if (!userPaused()) play();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!userPaused() && visible) play();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-brain-viz]').forEach(init);
</script>
