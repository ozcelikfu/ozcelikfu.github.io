---
// Critical-band masking, as an explorable: a letter in band-pass noise, and the
// (schematic) one-octave channel that predicts where the noise hurts most.
const bands = [0.75, 1.5, 3, 6, 12, 24];
const W = 320, H = 150, PAD = 28;
const fx = (f: number) => PAD + ((Math.log2(f) - Math.log2(0.5)) / (Math.log2(36) - Math.log2(0.5))) * (W - 2 * PAD);
const PEAK = 3; // cycles per letter
const SIGMA = 0.85; // octaves (FWHM ≈ 2 octaves on threshold elevation; schematic)
const curve = Array.from({ length: 80 }, (_, i) => {
  const lf = Math.log2(0.5) + (i / 79) * (Math.log2(36) - Math.log2(0.5));
  const y = Math.exp(-((lf - Math.log2(PEAK)) ** 2) / (2 * SIGMA * SIGMA));
  return `${i ? 'L' : 'M'}${fx(2 ** lf).toFixed(1)},${(H - PAD - y * (H - 2 * PAD)).toFixed(1)}`;
}).join(' ');
---
<figure class="viz channel" data-channel data-bands={JSON.stringify(bands)} data-peak={PEAK} data-sigma={SIGMA}>
  <div class="channel__pair">
    <canvas width="128" height="128" role="img" aria-label="A letter embedded in band-pass filtered noise"></canvas>
    <svg viewBox={`0 0 ${W} ${H}`} class="channel__plot" role="img" aria-label="Schematic plot: threshold elevation peaks when the noise is at about 3 cycles per letter">
      <line x1={PAD} y1={H - PAD} x2={W - PAD} y2={H - PAD} class="axis" />
      <line x1={PAD} y1={PAD - 8} x2={PAD} y2={H - PAD} class="axis" />
      {bands.map((b) => (
        <g>
          <line x1={fx(b)} x2={fx(b)} y1={H - PAD} y2={H - PAD + 4} class="axis" />
          <text x={fx(b)} y={H - PAD + 16} text-anchor="middle">{b}</text>
        </g>
      ))}
      <text x={W - PAD} y={H - 2} text-anchor="end">noise frequency (c/letter)</text>
      <text x={PAD + 6} y={PAD - 12}>threshold elevation</text>
      <path d={curve} class="curve" />
      <line class="marker" data-marker x1="0" x2="0" y1={PAD - 6} y2={H - PAD} />
      <circle class="dot" data-dot r="4.5" cx="0" cy="0" />
    </svg>
  </div>
  <div class="channel__controls">
    <label class="mono channel__label" for="channel-range">Noise band</label>
    <input id="channel-range" type="range" min="0" max={bands.length - 1} step="1" value="1" />
    <p class="channel__desc" aria-live="polite" data-desc></p>
  </div>
  <figcaption class="viz__note mono">Schematic illustration of critical-band masking (after Solomon &amp; Pelli, 1994) — not data from the study.</figcaption>
</figure>

<style>
  .channel { margin: 0; display: grid; gap: 1rem; }
  .channel__pair { display: grid; grid-template-columns: 128px 1fr; gap: 1.25rem; align-items: center; }
  .channel canvas { width: 128px; height: 128px; border-radius: 10px; border: 1px solid var(--line); image-rendering: pixelated; }
  .channel__plot { width: 100%; height: auto; overflow: visible; }
  .channel__plot text { font-family: var(--font-mono); font-size: 9px; fill: var(--muted); }
  .channel__plot .axis { stroke: var(--line-2); stroke-width: 1; }
  .channel__plot .curve { fill: none; stroke: var(--accent); stroke-width: 2; }
  .channel__plot .marker { stroke: var(--hot); stroke-dasharray: 3 3; stroke-width: 1; transition: transform 0.35s var(--ease); }
  .channel__plot .dot { fill: var(--hot); transition: transform 0.35s var(--ease); }
  .channel__label { display: block; color: var(--muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.3rem; }
  .channel input[type='range'] { width: 100%; accent-color: var(--hot); }
  .channel__desc { margin: 0.6rem 0 0; color: var(--text-2); font-size: 0.95rem; min-height: 3.2em; }
  .viz__note { margin: 0; font-size: 0.68rem; color: var(--muted); }
  @media (max-width: 520px) { .channel__pair { grid-template-columns: 1fr; } }
</style>

<script>
  import { rng, gaussian } from '../../scripts/scene';

  const N = 128;
  const LETTERS = 'DHKNORSVZC';

  // separable box blur with wrap-around, repeated 3× ≈ gaussian
  function boxBlur(src: Float32Array, r: number) {
    if (r < 1) return src.slice();
    const tmp = new Float32Array(N * N), out = new Float32Array(N * N);
    const w = 2 * r + 1;
    for (let y = 0; y < N; y++) {
      let acc = 0;
      for (let k = -r; k <= r; k++) acc += src[y * N + ((k + N) % N)];
      for (let x = 0; x < N; x++) {
        tmp[y * N + x] = acc / w;
        acc += src[y * N + ((x + r + 1) % N)] - src[y * N + ((x - r + N) % N)];
      }
    }
    for (let x = 0; x < N; x++) {
      let acc = 0;
      for (let k = -r; k <= r; k++) acc += tmp[((k + N) % N) * N + x];
      for (let y = 0; y < N; y++) {
        out[y * N + x] = acc / w;
        acc += tmp[((y + r + 1) % N) * N + x] - tmp[((y - r + N) % N) * N + x];
      }
    }
    return out;
  }
  function gaussBlur(src: Float32Array, sigma: number) {
    if (sigma < 0.35) return src.slice();
    const r = Math.max(1, Math.round(Math.sqrt((12 * sigma * sigma) / 3 + 1) / 2 - 0.5));
    return boxBlur(boxBlur(boxBlur(src, r), r), r);
  }

  function init(root: HTMLElement) {
    const bands: number[] = JSON.parse(root.dataset.bands!);
    const peak = Number(root.dataset.peak), sigma = Number(root.dataset.sigma);
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    const range = root.querySelector<HTMLInputElement>('input')!;
    const desc = root.querySelector<HTMLElement>('[data-desc]')!;
    const marker = root.querySelector<SVGLineElement>('[data-marker]')!;
    const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
    const svg = root.querySelector('svg')!;
    const [W, H] = svg.viewBox.baseVal ? [svg.viewBox.baseVal.width, svg.viewBox.baseVal.height] : [320, 150];
    const PAD = 28;
    const fx = (f: number) => PAD + ((Math.log2(f) - Math.log2(0.5)) / (Math.log2(36) - Math.log2(0.5))) * (W - 2 * PAD);

    const r = rng(11);
    const white = new Float32Array(N * N);
    for (let i = 0; i < white.length; i++) white[i] = gaussian(r);

    const letterH = 0.6 * N; // px
    // DoG with σ2 = 2σ1 peaks at f ≈ 0.153/σ1 cycles/px
    const noiseFor = (fcpl: number) => {
      const s1 = (0.153 * letterH) / fcpl;
      const a = gaussBlur(white, s1), b = gaussBlur(white, 2 * s1);
      const d = new Float32Array(N * N);
      let ss = 0;
      for (let i = 0; i < d.length; i++) { d[i] = a[i] - b[i]; ss += d[i] * d[i]; }
      const sd = Math.sqrt(ss / d.length) || 1;
      for (let i = 0; i < d.length; i++) d[i] /= sd;
      return d;
    };
    const cache = new Map<number, Float32Array>();

    let letter = 'K';
    function letterMask(ch: string) {
      const c = document.createElement('canvas');
      c.width = c.height = N;
      const g = c.getContext('2d')!;
      g.fillStyle = '#000';
      g.fillRect(0, 0, N, N);
      g.fillStyle = '#fff';
      g.font = `600 ${Math.round(letterH * 1.38)}px 'Inter Variable', Arial, sans-serif`;
      g.textAlign = 'center';
      g.textBaseline = 'alphabetic';
      g.fillText(ch, N / 2, N / 2 + letterH / 2);
      const d = g.getImageData(0, 0, N, N).data;
      const m = new Float32Array(N * N);
      for (let i = 0; i < m.length; i++) m[i] = d[i * 4] / 255;
      return m;
    }

    function render() {
      const k = Number(range.value);
      const f = bands[k];
      if (!cache.has(k)) cache.set(k, noiseFor(f));
      const noise = cache.get(k)!;
      const mask = letterMask(letter);
      const img = ctx.createImageData(N, N);
      for (let i = 0; i < N * N; i++) {
        const v = 200 - mask[i] * 120 + noise[i] * 38;
        img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = Math.max(0, Math.min(255, v));
        img.data[i * 4 + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);

      const y = Math.exp(-((Math.log2(f) - Math.log2(peak)) ** 2) / (2 * sigma * sigma));
      const x = fx(f), yy = H - PAD - y * (H - 2 * PAD);
      marker.setAttribute('x1', String(x));
      marker.setAttribute('x2', String(x));
      dot.setAttribute('cx', String(x));
      dot.setAttribute('cy', String(yy));
      const where = y > 0.8 ? 'right on the channel — the letter is hardest to read here.' : y > 0.35 ? 'on the flank of the channel — partially masking.' : 'far from the channel — the letter stays easy to read.';
      desc.textContent = `Noise centred at ${f} cycles per letter: ${where}`;
      range.setAttribute('aria-valuetext', `${f} cycles per letter`);
    }

    range.addEventListener('input', () => {
      letter = LETTERS[Math.floor(Math.random() * LETTERS.length)];
      render();
    });
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-channel]').forEach(init);
</script>
