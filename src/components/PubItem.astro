---
import { ME, linkList, primaryHref, typeLabels, type Publication } from '../data/publications';
import Icon from './Icon.astro';
interface Props { p: Publication }
const { p } = Astro.props;
const links = linkList(p);
const href = primaryHref(p);
const isMe = (a: string) => a === ME || a === 'Furkan Özçelik';
---
<article class="pub" data-type={p.type} id={p.id}>
  <div class="pub__meta mono">
    <span class="chip">{typeLabels[p.type]}</span>
    {p.note && <span class="chip chip--hot">{p.note}</span>}
    {p.lang === 'tr' && <span class="chip">in Turkish</span>}
  </div>
  <h3 class="pub__title" lang={p.lang}>
    {href ? <a href={href} target="_blank" rel="noopener">{p.title}</a> : p.title}
  </h3>
  {p.translation && <p class="pub__translation">“{p.translation}”</p>}
  <p class="pub__authors">
    {p.authors.map((a, i) => (
      <>
        {isMe(a) ? <strong>{a}</strong> : a}{i < p.authors.length - 1 ? ', ' : ''}
      </>
    ))}
  </p>
  <p class="pub__venue" lang={p.lang}>{p.venue}{p.year && !p.venue.includes(String(p.year)) && `, ${p.year}`}</p>
  {links.length > 0 && (
    <ul class="pub__links" role="list">
      {links.map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener">{l.label === 'Code' && <Icon name="code" size={14} />}{l.label}</a></li>
      ))}
    </ul>
  )}
</article>

<style>
  .pub { padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .pub__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; }
  .pub__title { font-size: 1.3rem; line-height: 1.3; margin: 0 0 0.35rem; }
  .pub__title a { text-decoration: none; }
  .pub__title a:hover { text-decoration: underline; }
  .pub__translation { margin: 0 0 0.35rem; color: var(--muted); font-style: italic; font-size: 0.95rem; }
  .pub__authors { margin: 0 0 0.15rem; color: var(--text-2); font-size: 0.95rem; }
  .pub__authors strong { color: var(--text); font-weight: 600; }
  .pub__venue { margin: 0; color: var(--muted); font-size: 0.92rem; font-style: italic; }
  .pub__links { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0.75rem 0 0; padding: 0; }
  .pub__links a {
    display: inline-flex; align-items: center; gap: 0.35em;
    font-family: var(--font-mono); font-size: 0.74rem; text-decoration: none;
    padding: 0.3em 0.75em; border-radius: 8px; border: 1px solid var(--line-2); color: var(--text-2);
  }
  .pub__links a:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
</style>
